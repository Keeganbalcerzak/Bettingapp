# Get a free key at https://the-odds-api.com (500 credits/month on the free plan).
# Without a key the app runs in demo mode: real ESPN schedules, injuries and stats,
# but simulated sportsbook prices.
ODDS_API_KEY=

# How long (seconds) to reuse odds before spending credits again. Each sport refresh
# costs about 3 credits (moneyline + spread + total across up to 10 books).
ODDS_CACHE_SECONDS=600

# Books to pull (max 10 keeps the cost at 1 region). FanDuel is always included.
ODDS_BOOKMAKERS=fanduel,pinnacle,draftkings,betmgm,williamhill_us,betonlineag,lowvig,bovada,betrivers,fanatics
